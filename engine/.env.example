# SWK Growth engine: copy to .env (never commit .env). All values below are placeholders.
OS_BASE_URL=https://os.swkpropertiesuae.com
# API key minted by the Owner in SWK OS, acting as the low-privilege "Growth Sync" user. Shown once at creation.
OS_API_KEY=
# Writes to SWK OS happen only when this is true. Leave false until a dry run has been reviewed.
OS_SEND=false
# SWK OS user ids that receive routed leads (look up with GET /api/e/users/lookup?q=name)
GROWTH_AGENT_USER_ID=
GROWTH_BDM_USER_ID=
GROWTH_MANAGER_USER_ID=
# The single agent's working hours in Dubai time
AGENT_SHIFT={"days":["Mon","Tue","Wed","Thu","Fri","Sat"],"start":"09:00","end":"19:00"}
# Intake server
INTAKE_PORT=8090
INTAKE_SECRET=
OS_WEBHOOK_SECRET=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
GROWTH_DATA_DIR=./data/runtime
